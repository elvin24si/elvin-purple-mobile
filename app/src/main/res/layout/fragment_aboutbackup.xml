<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- THE TOOLBAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAbout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:title="Tentang"
        app:titleTextColor="@color/textPrimary"
        app:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topBackgroundAbout"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_wavy_about"
        android:alpha="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarAbout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarAbout"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informasi &amp; Fitur"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:fontFamily="@font/robotomono" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bina Desa Menu Selengkapnya"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:fontFamily="@font/robotomono"
            android:layout_marginBottom="24dp" />

        <!-- THE LISTVIEW CONTAINER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <!-- ListView handles its own internal scrolling, so no ScrollView wrapper needed -->
            <ListView
                android:id="@+id/listViewAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:divider="#EEEEEE"
                android:dividerHeight="1dp"
                android:padding="8dp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>