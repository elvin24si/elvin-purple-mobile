<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- REQUIRED TOOLBAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMain"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:title="Dashboard"
        app:titleTextColor="@color/textPrimary"
        app:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtle soft blue accent at the top -->

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarMain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:elevation="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BINA DESA"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/robotomono"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Produk Hukum dan Dokumen Publik"
            android:textColor="@color/agakitem"
            android:gravity="center"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/robotomono"/>

        <View
            android:id="@+id/topBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.4"
            android:background="@drawable/gradient_bg"
            app:layout_constraintHeight_percent="0.6" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRumus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Rumus"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            app:backgroundTint="@color/colorAccent"
            app:cornerRadius="12dp"
            android:fontFamily="@font/robotomono" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcome"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Welcome Screen"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            app:backgroundTint="@color/colorAccent"
            app:cornerRadius="12dp"
            android:fontFamily="@font/robotomono" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWebView"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Portal Web Bina Desa"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp"
            android:fontFamily="@font/robotomono" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:text="About Us"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            app:strokeColor="@color/colorPrimary"
            app:cornerRadius="12dp"
            android:fontFamily="@font/robotomono" />

        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Logout Session"
            android:textColor="#FF5252"
            android:textStyle="bold"
            android:padding="12dp"
            android:fontFamily="@font/robotomono" />

    </LinearLayout>

    <TextView
        android:id="@+id/copyrightText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copyright © Bina Desa Labs"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="@font/robotomono"/>

</androidx.constraintlayout.widget.ConstraintLayout>