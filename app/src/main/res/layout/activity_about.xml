<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <View
        android:id="@+id/headerBg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/gradient_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvJudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/robotomono"
        android:text="Judul"
        android:textColor="@color/agakitem"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDeskripsi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:fontFamily="@font/robotomono"
        android:gravity="center"
        android:text="Deskripsi"
        android:textColor="#757575"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvJudul" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDeskripsi"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/logo" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="@color/agakitem"
                android:layout_marginVertical="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Our Mission"
                android:textColor="@color/agakitem"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/robotomono"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WhiteFrame Labs hadir untuk merevolusi standar market PC pre-built di Indonesia. Kami melihat maraknya praktik 'cut corner' demi perang harga yang mengorbankan kualitas dan keamanan konsumen.\n\nKami menolak penggunaan komponen yang tidak handal. WhiteFrame Labs hanya menghadirkan PC Premium dengan kurasi part terbaik, memberikan edukasi teknis melalui media sosial, dan memastikan investasi teknologi Anda aman untuk jangka panjang."
                android:textColor="@color/agakitem"
                android:lineSpacingExtra="6dp"
                android:textSize="14sp"
                android:fontFamily="@font/robotomono"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>